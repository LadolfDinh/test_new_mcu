# ===== Mô phỏng MuJoCo - file tạm khi biên dịch firmware cho PC =====
# Giữ lại build/fw_sim.dll + .stamp (bản dựng sẵn cho máy không có trình biên dịch C)
sim_mujoco/build/*
!sim_mujoco/build/fw_sim.dll
!sim_mujoco/build/fw_sim.dll.stamp

